# Valeurs par défaut lues par les scripts (utile pour un lancement hors Docker).
# Avec docker compose, ces variables sont définies dans docker-compose.yml.
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=iot-sensor-data
SEND_INTERVAL_SEC=2

ES_NODES=localhost
ES_PORT=9200
ES_INDEX=iot-telemetry-metrics

CHECKPOINT_DIR=/tmp/spark_es_checkpoint
STARTUP_DELAY_SEC=20
